rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasValidSession(userId, data) {
      return exists(/databases/$(database)/documents/active_sessions/$(userId)) &&
             sessionChecks(get(/databases/$(database)/documents/active_sessions/$(userId)).data, data);
    }

    function sessionChecks(session, data) {
      let elapsedSeconds = (request.time.toMillis() - session.startedAt.toMillis()) / 1000;
      return data.durationSeconds == session.durationSeconds &&
             elapsedSeconds >= 0 &&
             data.totalAnswered <= (elapsedSeconds * 2 + 5) &&
             elapsedSeconds <= (session.durationSeconds + 90);
    }

    match /active_sessions/{userId} {
      allow read: if false;
      allow create, update: if
        request.resource.data.username == userId &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.username.size() <= 50 &&
        request.resource.data.durationSeconds is int &&
        request.resource.data.durationSeconds in [60, 90, 156, 200, 500, 560, 10000] &&
        request.resource.data.startedAt == request.time;
      allow delete: if false;
    }

    match /leaderboard/{userId} {

      // Anyone can read the leaderboard
      allow read: if true;

      // Writes must pass all of these checks:
      allow write: if
        // 1. All required fields must be present
        request.resource.data.keys().hasAll([
          'username', 'points', 'correctCount', 'totalAnswered', 'durationSeconds', 'timestamp'
        ]) &&

        // 2. Username in the document must match the document ID
        request.resource.data.username == userId &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.username.size() <= 50 &&

        // 3. Proper types and non-negative values
        request.resource.data.points is int &&
        request.resource.data.correctCount is int &&
        request.resource.data.totalAnswered is int &&
        request.resource.data.durationSeconds is int &&
        request.resource.data.timestamp is int &&
        request.resource.data.points       >= 0 &&
        request.resource.data.correctCount >= 0 &&
        request.resource.data.totalAnswered >= 0 &&

        // 4. Points must equal correctCount × 10 exactly
        request.resource.data.points == request.resource.data.correctCount * 10 &&

        // 5. Can't have more correct answers than total answers
        request.resource.data.correctCount <= request.resource.data.totalAnswered &&

        // 6. Duration must be a supported game mode
        request.resource.data.durationSeconds in [60, 90, 156, 200, 500, 560, 10000] &&

        // 7. Max answered questions cannot exceed twice the duration in seconds
        request.resource.data.totalAnswered <= request.resource.data.durationSeconds * 2 &&

        // 8. Server-verified timing validation against active_sessions
        hasValidSession(userId, request.resource.data) &&

        // 9. Score can only go up — prevents someone overwriting
        //    a legitimate high score with a lower (or fake) one
        (resource == null || request.resource.data.points >= resource.data.points);
    }

    match /sessions/{sessionId} {
      // Not publicly readable — only visible to you via Firebase Console (admin SDK bypasses rules)
      allow read: if false;

      // Anyone starting a game can write one entry — just validate it has the basics
      allow create: if
        request.resource.data.keys().hasAll(['username', 'ip', 'timestamp']) &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.username.size() <= 50;

      // Nobody can edit or delete session logs
      allow update, delete: if false;
    }

  }
}
